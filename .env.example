TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domain-root deployment:
# PUBLIC_BASE_URL=https://uploader.example.com
# GOOGLE_REDIRECT_URI=https://uploader.example.com/api/storage/google/callback
# Shared-domain path deployment:
PUBLIC_BASE_URL=https://playbuddy.zapto.org/uploader
GOOGLE_REDIRECT_URI=https://playbuddy.zapto.org/uploader/api/storage/google/callback

DATABASE_PATH=/data/app.db
USER_DATA_ROOT=/data/users
PENDING_TELEGRAM_ROOT=/data/pending-telegram
USER_RCLONE_ROOT=/config/users
BOT_SESSION_PATH=/data/bot.session

# Telegram numeric user ID that may use the private `/db` admin commands.
# Leave blank to disable all admin commands.
ADMIN_TELEGRAM_USER_ID=
ADMIN_CONTACT=

WEB_HOST=0.0.0.0
WEB_PORT=8080
QR_LOGIN_TTL_SECONDS=120
PHONE_LOGIN_TTL_SECONDS=300
MAX_TELEGRAM_CODE_ATTEMPTS=5
TELEGRAM_2FA_TTL_SECONDS=300
MAX_TELEGRAM_2FA_ATTEMPTS=5
WEB_SESSION_TTL_SECONDS=1800
ONBOARDING_TOKEN_TTL_SECONDS=600
OAUTH_STATE_TTL_SECONDS=600

DEFAULT_RCLONE_REMOTE=gdrive
DEFAULT_UPLOAD_DIRECTORY=DOWNLOADS
# Deprecated compatibility setting; per-user roots now come from Telegram
# names or the private `/dirroot` command.
RCLONE_BASE_PATH=UPLOADS
REMOTE_COLLISION_POLICY=rename
RCLONE_DRIVE_CHUNK_SIZE=64Mi
RCLONE_RETRIES=5
RCLONE_LOW_LEVEL_RETRIES=10
RCLONE_RETRIES_SLEEP_SECONDS=10
RCLONE_STATS_INTERVAL_SECONDS=2
RCLONE_UPLOAD_TIMEOUT_MINUTES=180
RCLONE_TRANSFERS=1
RCLONE_CHECKERS=2

MAX_CONNECTED_USERS=100
# Maximum simultaneous Telegram onboarding flows across QR and phone login.
MAX_PENDING_QR_LOGINS=10
# Maximum Google Drive remotes per Telegram user. Every remote must use a
# different verified Google account.
MULTY_RCLONE_COUNT=2
# 0 disables the application file-size ceiling.
MAX_FILE_SIZE_BYTES=0
MIN_FREE_DISK_BYTES=5368709120
# Number of distinct users whose oldest file may run end-to-end in parallel.
# Each user can occupy only one worker; remaining work stays FIFO queued.
MAX_CONCURRENT_USER_WORKERS=2
QUEUE_POLL_INTERVAL_SECONDS=1
PROGRESS_UPDATE_INTERVAL_SECONDS=5
TELEGRAM_DOWNLOAD_CONNECTIONS=4
TELEGRAM_DOWNLOAD_STALL_TIMEOUT_SECONDS=120
PARALLEL_DOWNLOAD_MIN_SIZE_MB=64
DELETE_LOCAL_AFTER_SUCCESS=true

LOG_LEVEL=INFO
LOG_FILE=/data/logs/uploader.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
